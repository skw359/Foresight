# Foresight Security recorder configuration. Copy to ".env" and adjust.
#   Linux / macOS : cp .env.example .env
#   Windows       : copy .env.example .env

# The recorder REFUSES TO START on an empty, short (< 32 chars) or template
# secret. Generate secrets with `openssl rand -hex 32` and copy the SAME values
# into foresight-server/.env (and infra/livekit.yaml for the LiveKit key).

# --- LiveKit (use the SAME values as foresight-server/.env) ---
# The recorder connects to LiveKit directly; co-located on one box that is
# loopback, and these keys must match infra/livekit.yaml's `keys:` block.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=foresight
LIVEKIT_API_SECRET=

# --- Control API ---
# Loopback port the server's webhook + toggle POST arm/disarm to.
RECORDER_PORT=3399
# Required. MUST equal foresight-server's RECORDER_SHARED_SECRET.
RECORDER_SHARED_SECRET=

# --- Media / ffmpeg ---
# Leave unset and the recorder prefers its bundled bin/ffmpeg (bin/ffmpeg.exe on
# Windows), falling back to "ffmpeg" on PATH. Set it explicitly to override:
#   a bare name  ("ffmpeg")            -> resolved on PATH, e.g. apt/brew installs
#   a path       ("./bin/ffmpeg")      -> relative to the recorder package root
#   an abs path  ("/usr/bin/ffmpeg")   -> used as-is
# FFMPEG_PATH=ffmpeg
# Where segments are written. MUST equal foresight-server's RECORDINGS_DIR so the
# server can serve them back. Use an ABSOLUTE path:
#   Linux / macOS : /var/lib/foresight/recordings  (or ~/foresight-recordings)
#   Windows       : D:\foresight-recordings
# On a dedicated disk, point this at a SUBDIRECTORY of the mount, not the mount
# root (e.g. /mnt/foresight/recordings, not /mnt/foresight): ffmpeg runs with
# -strftime_mkdir 1, so an unmounted disk would not error — it would silently
# recreate the tree on the root filesystem. Pair it with the ExecStartPre
# mount-wait in the unit (infra/systemd/install-user-units.sh derives this from
# /etc/fstab automatically).
RECORDINGS_DIR=/var/lib/foresight/recordings
# Which simulcast layer the recorder pins its subscription to (low|medium|high).
# Unpinned, the SFU forwards and demotes layers at will and footage ends up
# anywhere from 240x135 to 1080p, so 24/7 recording wants the top layer.
RECORD_LAYER=high
# Ceiling on the encode geometry (height px, aspect preserved). 0 = record at
# the camera's own published resolution. Every segment for a camera is encoded
# at ONE geometry regardless of the layer that arrives, so this bounds the
# continuous-encode cost — set 1080 if a 4K publisher outruns the CPU.
RECORD_MAX_HEIGHT=0
# v1 records video only; A/V sync is milestone M4.
RECORD_AUDIO=false
SEGMENT_SECONDS=6
# Output frame rate of recordings. Frames are paced onto it by their real
# timestamps (slower cameras get repeated frames), so playback speed and segment
# timing are always correct. Lowered automatically while the host can't keep up.
RECORD_FPS=30
# libx264 (default) or h264_nvenc when an NVIDIA GPU is present. Check what your
# build actually has:  ffmpeg -hide_banner -encoders | grep 264
ENCODER=libx264

# --- Retention (whichever limit hits first) ---
RETENTION_DAYS=14
RETENTION_MAX_GB=500
MIN_FREE_GB=25
# When the DISK budget forces pruning: "fair" trims the camera using the most
# space first (default); "oldest" deletes the globally oldest footage first.
# RETENTION_POLICY=fair

# --- Reconcile (self-healing backstop) ---
# Where to ask "which cameras should be recording?" — the server's INTERNAL API
# listener (foresight-server INTERNAL_PORT, loopback only), NOT its public port.
SERVER_URL=http://127.0.0.1:3198

# --- E2EE (Model B) ---
# The recorder's X25519 identity (sk||pk, base64). The secret key at rest IS the
# consent boundary: keep it OUTSIDE RECORDINGS_DIR (the server reads that tree)
# and chmod 600. Default: ./data/recorder-identity.key under the package root.
# RECORDER_KEY_PATH=./data/recorder-identity.key
# Frame watchdog: if a recording camera yields no frame for this many seconds
# (a keyless/revoked stream goes silent with no error), finalize the open
# segment and mark it `stalled`.
# FRAME_STALL_SECONDS=15

# Optional: LOG_LEVEL=debug for verbose ffmpeg/livekit logs. ffmpeg failures are
# always logged at error level with its last stderr lines.
# LOG_LEVEL=info

# Accept template/short secrets for a THROWAWAY local setup only.
# FORESIGHT_INSECURE_DEV=1
