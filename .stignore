#escape=\



// OS / editor noise

(?d).DS_Store

(?d)Thumbs.db

(?d)desktop.ini

(?d).Spotlight-V100

(?d).Trashes



// JS/TS dependencies and build output

(?d)node_modules

(?d)dist

(?d)dist-ssr

(?d).vite

(?d).cache

(?d).turbo

(?d).next

(?d).nuxt

(?d)coverage

(?d).nyc_output



// Swift / Xcode build output

(?d)build

(?d).build

(?d)DerivedData

(?d)xcuserdata

(?d)*.xcuserstate

(?d)**/.swiftpm/xcode



// Logs

(?d)logs

(?d)*.log

(?d)npm-debug.log*

(?d)yarn-debug.log*

(?d)pnpm-debug.log*



// Keep env examples, ignore real machine-local env files

!.env.example

*.local



// Local app state / generated data

**/prisma/*.db

**/prisma/*.db-journal

**/prisma/*.db-wal

**/prisma/*.db-shm

database.json

database-export.json

recordings

uploads

photos



// Downloaded/native local binaries

ffmpeg

ffmpeg.exe

ffprobe

ffprobe.exe

livekit-server



