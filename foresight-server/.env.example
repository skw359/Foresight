# Foresight Security backend configuration.
# Copy to ".env" and fill in the secrets — the server REFUSES TO START on an
# empty, short (< 32 chars) or template secret. Generate each one with:
#     openssl rand -hex 32
# (Windows PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# HTTP port the Fastify server listens on (all interfaces).
PORT=3199

# Prisma / SQLite database location. A relative path is resolved against the
# foresight-server/ directory (where prisma.config.ts lives), so this is
# foresight-server/dev.db. It holds every account and E2EE key vault — back it
# up (see infra/UBUNTU-SETUP.md, "Backups").
DATABASE_URL="file:./dev.db"

# Signs user session JWTs. REQUIRED: openssl rand -hex 32
JWT_SECRET=
# How long a session lasts before the user must sign in again. Sessions can
# also be revoked server-side ("sign out everywhere", password change).
# SESSION_TTL=14d

# LiveKit connection details. The key/secret MUST match the `keys:` block in
# infra/livekit.yaml. The secret is REQUIRED and must be generated
# (openssl rand -hex 32) — never LiveKit's well-known dev pair devkey/secret
# outside a throwaway local setup.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=foresight
LIVEKIT_API_SECRET=

# URL advertised to cameras and viewers (embedded in QR pairing tickets and
# /rt/token responses). It must be reachable FROM THE DEVICE -- "localhost"
# resolves to the phone/simulator itself, not the LiveKit server. Set it to the
# LiveKit server's LAN address, e.g. ws://192.168.1.20:7880. Defaults to
# LIVEKIT_URL when unset (only correct when the device shares this host). Find
# this host's LAN IP with `hostname -I` (Linux), `ipconfig getifaddr en0`
# (macOS) or `ipconfig` (Windows) — infra/run-local.sh also prints it on boot.
LIVEKIT_PUBLIC_URL=ws://192.168.1.20:7880

# OPTIONAL last-resort fallback for the QR pairing base URL. The admin's
# dashboard setting and per-request auto-detection both take precedence.
# PUBLIC_SERVER_URL=http://192.168.1.20:3199

# ------------------------------------------------------------ Access policy
# Who may create accounts. The FIRST account on a server is always allowed and
# becomes the server admin (the only one who can change server-wide settings).
#   unset  -> the admin decides from the dashboard (Settings); closed by default
#   true   -> always open (anyone who can reach the server can sign up)
#   false  -> always closed
# ALLOW_REGISTRATION=
# Extra browser origins allowed to call the API cross-origin (comma-separated),
# e.g. a dashboard hosted elsewhere. Same-origin and localhost dev servers are
# always allowed.
# CORS_ORIGINS=https://dashboard.example.com
# Set to true when the server sits behind a reverse proxy, so rate limits key on
# the real client address (X-Forwarded-For) instead of the proxy's.
# TRUST_PROXY=false

# ----------------------------------------------------------------- Recording
# The foresight-recorder process exposes a loopback-only control API. The
# webhook + recording toggle POST arm/disarm here. Must match the recorder's
# RECORDER_PORT.
RECORDER_URL=http://127.0.0.1:3399
# Shared secret for every server<->recorder call (openssl rand -hex 32); must
# equal the recorder's RECORDER_SHARED_SECRET. Leave unset to disable
# server<->recorder calls entirely (the recorder then can't reconcile).
RECORDER_SHARED_SECRET=
# The recorder's reconcile API is served on its OWN port, bound to 127.0.0.1
# only — never on PORT. The recorder's SERVER_URL must point here.
INTERNAL_PORT=3198
# Directory the recorder writes HLS segments to; the server reads it back to
# serve playlists, segments, and clips. Use the SAME ABSOLUTE path in both
# .env files:
#   Linux / macOS : /var/lib/foresight/recordings  (or ~/foresight-recordings)
#   Windows       : D:\foresight-recordings
RECORDINGS_DIR=/var/lib/foresight/recordings
# ffmpeg used to remux clip downloads. Defaults to "ffmpeg" on PATH, which is
# where apt/brew put it. With no system ffmpeg, point this at the recorder's
# bundled binary: ../foresight-recorder/bin/ffmpeg (ffmpeg.exe on Windows).
FFMPEG_PATH=ffmpeg
# Clip export limits: longest range per export (seconds), and how many exports
# may run at once server-wide / per user.
# CLIP_MAX_SECONDS=7200
# CLIP_MAX_CONCURRENT=2
# CLIP_MAX_PER_USER=1

# ------------------------------------------------------------- Development
# Accept template/short secrets (devkey/secret, `livekit-server --dev`) for a
# THROWAWAY local setup only. Never set this on a reachable server.
# FORESIGHT_INSECURE_DEV=1
